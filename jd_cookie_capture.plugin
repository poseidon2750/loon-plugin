http-request https:\/\/ms\.jr\.jd\.com\/ script-path=jd_cookie.js, tag=京东Cookie-JR, enabled=true, content="#!name=jd_cookie\nconst url=$request.url;const h=$request.headers['Cookie']||'';const m=h.match(/pt_key=([^;]+)/);const p=h.match(/pt_pin=([^;]+)/);if(m&&p){const r=m[0]+';'+p[0]+';';const pin=decodeURIComponent((p[0].match(/pt_pin=([^;]+)/)||['',''])[1]);let s=$persistentStore.read('JD_CK')||'';if(!s.includes(p[0])){s=s?s+'\\n'+r:r;$persistentStore.write(s,'JD_CK');$notification.post('✅京东Cookie','账号: '+pin,r.substring(0,25)+'...');console.log('[JD] '+r);}$done({});}else{$done({});}"

[MITM]
hostname = %APPEND% api.m.jd.com, me-api.jd.com, home.m.jd.com, ms.jr.jd.com
