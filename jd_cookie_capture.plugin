#!name=JD Cookie 捕获（增强命中版）
#!desc=优化MITM命中率版本

[MITM]
hostname = %APPEND% *.jd.com, *.360buyimg.com

[Script]
http-request ^https:\/\/.*jd\.com.* script-path=jd_cookie.js, tag=JD Cookie Capture, timeout=10

[Script Code]
jd_cookie.js = `
const h = $request.headers || {};
const cookie = h.Cookie || h.cookie;

if (!cookie) return $done({});

const key = cookie.match(/pt_key=([^;]+)/);
const pin = cookie.match(/pt_pin=([^;]+)/);

if (!key || !pin) return $done({});

const newCookie = \`pt_key=\${key[1]}; pt_pin=\${pin[1]};\`;

let list = [];
try {
  list = JSON.parse($persistentStore.read('JD_COOKIE_LIST') || '[]');
} catch {}

let updated = false;

const idx = list.findIndex(x => x.includes(\`pt_pin=\${pin[1]};\`));

if (idx === -1) {
  list.push(newCookie);
  updated = true;
} else if (list[idx] !== newCookie) {
  list[idx] = newCookie;
  updated = true;
}

if (updated) {
  $persistentStore.write(JSON.stringify(list), 'JD_COOKIE_LIST');

  $notification.post(
    'JD Cookie 捕获成功',
    decodeURIComponent(pin[1]),
    idx === -1 ? '新增账号' : '已更新'
  );
}

$done({});
`;
