#!name=京东Cookie捕获
#!desc=自动抓取pt_key+pt_pin（Loon最新版单文件版）
#!homepage=https://github.com/6dylan6/jdpro
#!icon=https://img12.360buyimg.com/img/jfs/t1/344493/13/26448/1881/6913e9baF4c5ab748/52238dc72ffe6b04.png
#!author=ChatGPT
#!loon_version=>=2.1.0
#!date=2026-06-20

[MITM]
hostname = %APPEND% api.m.jd.com, me-api.jd.com, home.m.jd.com, ms.jr.jd.com

[Script]
http-request ^https:\/\/api\.m\.jd\.com\/ script-path=jd_cookie.js, tag=JD Cookie Capture, timeout=10
http-request ^https:\/\/me-api\.jd\.com\/ script-path=jd_cookie.js, tag=JD Cookie Capture, timeout=10
http-request ^https:\/\/home\.m\.jd\.com\/ script-path=jd_cookie.js, tag=JD Cookie Capture, timeout=10
http-request ^https:\/\/ms\.jr\.jd\.com\/ script-path=jd_cookie.js, tag=JD Cookie Capture, timeout=10

[Script Code]
jd_cookie.js = `
(function () {

  const h = $request.headers || {};
  const cookie = h['Cookie'] || h['cookie'];

  if (!cookie) return $done({});

  const key = cookie.match(/pt_key=([^;]+)/);
  const pin = cookie.match(/pt_pin=([^;]+)/);

  if (!key || !pin) return $done({});

  const ptKey = key[1];
  const ptPin = pin[1];

  const newCookie = \`pt_key=\${ptKey}; pt_pin=\${ptPin};\`;

  let list = [];
  try {
    list = JSON.parse($persistentStore.read('JD_COOKIE_LIST') || '[]');
  } catch (e) {
    list = [];
  }

  let found = false;
  let changed = false;

  for (let i = 0; i < list.length; i++) {
    if (list[i].includes(\`pt_pin=\${ptPin};\`)) {
      found = true;

      if (list[i] !== newCookie) {
        list[i] = newCookie;
        changed = true;
      }
      break;
    }
  }

  if (!found) {
    list.push(newCookie);
    changed = true;
  }

  if (changed) {
    $persistentStore.write(JSON.stringify(list), 'JD_COOKIE_LIST');

    $notification.post(
      '京东Cookie更新',
      decodeURIComponent(ptPin),
      found ? '已刷新Cookie' : '新增账号'
    );
  }

  $done({});
})();
`;
